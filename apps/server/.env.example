# Copy to apps/server/.env (gitignored) — `npm run dev:server` loads it
# automatically. Every variable is optional for local development.

# Port the server listens on (default 3001).
PORT=3001

# Address to listen on. Leave unset (all interfaces) for local development; set
# to 127.0.0.1 when a reverse proxy on the same machine is the only caller.
# HOST=

# Google Books API key — gives this server its own request quota instead of
# the small pool shared by every keyless caller.
GOOGLE_BOOKS_API_KEY=

# Fallback Hardcover API token, used only for signed-out visitors (signed-in
# users' lookups run on their own token). With or without its leading
# "Bearer ". Enables ratings, reviews, and cover fallbacks from Hardcover.
HARDCOVER_API_KEY=

# Shared secret the app sends as X-App-Key. When set, every request except
# /health must carry it. Set the app's EXPO_PUBLIC_APP_SHARED_SECRET to the
# same value. Leave empty to skip the check (local/LAN development).
APP_SHARED_SECRET=

# Set only when deployed behind a load balancer or reverse proxy, so per-IP
# rate limiting uses the client's real IP from X-Forwarded-For: "true" (one
# proxy hop), a hop count like "2" (e.g. CDN + load balancer), or a
# comma-separated list of the proxies' IPs/CIDRs. Leave unset when the server
# is reached directly, or callers could spoof their IP.
TRUST_PROXY=

# Path to the exported web app's index.html. When set, GET /og/<page> serves it
# with link-preview tags for that page (see docs/deploy-social-cards.md).
WEB_INDEX_HTML=

# Public origin of the web app, used in preview URLs and the fallback image
# (default https://shelfthread.com).
PUBLIC_WEB_URL=

# --- Per-user Hardcover sign-in (all five required to enable; otherwise the
# /api/hardcover routes answer 503) ---
# Register the app at Hardcover → API → Developer Apps, type "Web app
# (server-side)". Leave Device Authorization Grant off.
MY_HARDCOVER_CLIENT_ID=
MY_HARDCOVER_CLIENT_SECRET=

# Redirect URI registered with Hardcover: https://<api host>/api/hardcover/callback
# (local dev: http://localhost:3001/api/hardcover/callback).
HARDCOVER_REDIRECT_URI=

# 32-byte key (base64) encrypting stored Hardcover tokens: openssl rand -base64 32
HARDCOVER_TOKEN_KEY=

# SQLite file holding sign-in sessions (gitignored *.db), e.g. ./accounts.db.
ACCOUNT_DB_PATH=

# Comma-separated prefixes the app may be sent back to after sign-in. Each must
# end in "/" or "://". Bare https://, http:// and exp:// are ignored because
# they would match anyone's address. Defaults to bookexplorer://,<PUBLIC_WEB_URL
# or https://shelfthread.com>/. Add exp://<your-lan-ip>:8081/ for Expo Go, and
# http://localhost:8081/ for local web dev.
HARDCOVER_RETURN_URLS=

# --- `npm run usage-report` (runs on your laptop, not the droplet) ---
# SSH target of the droplet, as you'd type it after `ssh`, e.g. user@host.
USAGE_SSH=

# The API's name in `pm2 list` on the droplet.
USAGE_PM2_NAME=
