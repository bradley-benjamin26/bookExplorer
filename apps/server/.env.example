# Copy to apps/server/.env (gitignored) — `npm run dev:server` loads it
# automatically. Every variable is optional for local development.

# Port the server listens on (default 3001).
PORT=3001

# Google Books API key — gives this server its own request quota instead of
# the small pool shared by every keyless caller.
GOOGLE_BOOKS_API_KEY=

# Hardcover API token (account settings → API), with or without its leading
# "Bearer ". Enables ratings, reviews, and cover fallbacks from Hardcover.
HARDCOVER_API_KEY=

# Shared secret the app sends as X-App-Key. When set, every request except
# /health must carry it. Set the app's EXPO_PUBLIC_APP_SHARED_SECRET to the
# same value. Leave empty to skip the check (local/LAN development).
APP_SHARED_SECRET=

# Set only when deployed behind a load balancer or reverse proxy, so per-IP
# rate limiting uses the client's real IP from X-Forwarded-For: "true" (one
# proxy hop), a hop count like "2" (e.g. CDN + load balancer), or a
# comma-separated list of the proxies' IPs/CIDRs. Leave unset when the server
# is reached directly, or callers could spoof their IP.
TRUST_PROXY=

# Path to the exported web app's index.html. When set, GET /og/<page> serves it
# with link-preview tags for that page (see docs/deploy-social-cards.md).
WEB_INDEX_HTML=

# Public origin of the web app, used in preview URLs and the fallback image
# (default https://shelfthread.com).
PUBLIC_WEB_URL=
