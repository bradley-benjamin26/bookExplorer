{
  "expo": {
    "name": "Book Explorer",
    "slug": "book-explorer",
    "scheme": "bookexplorer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bbradle1.bookexplorer",
      "infoPlist": {
        "NSCameraUsageDescription": "Book Explorer uses the camera to scan book barcodes."
      }
    },
    "android": {
      "package": "com.bbradle1.bookexplorer",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Book Explorer uses the camera to scan book barcodes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "90a4fb20-31a2-43e3-b63a-2afa3224cbc8"
      }
    },
    "owner": "engomia"
  }
}
